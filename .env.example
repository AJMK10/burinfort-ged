# ─── Copier ce fichier en .env et remplir les valeurs ───────────────────────
# Ne JAMAIS committer le fichier .env dans git

# Gmail SMTP (App Password sans espaces)
MAIL_USERNAME=ajmkprod@gmail.com
MAIL_PASSWORD=votre_app_password_ici

# Domaine de production
PUBLIC_DOMAIN=ged.burinfort.com

# Port interne exposé sur le host (Traefik → host)
APP_HOST_PORT=8085

# Mot de passe admin Alfresco (changez en production !)
ALFRESCO_ADMIN_PASSWORD=admin

# ─── OpenClaw — Agent IA (https://openclaw.ai) ───────────────────────────────
# Clé API Anthropic (Claude) pour OpenClaw
ANTHROPIC_API_KEY=sk-ant-votre-cle-ici

# Jeton d'accès à l'interface OpenClaw (choisissez un mot de passe fort)
OPENCLAW_GATEWAY_TOKEN=changeme

# Image Docker OpenClaw (laisser vide pour utiliser la dernière version)
# OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
